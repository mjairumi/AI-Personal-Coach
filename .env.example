# --- Required ---
# Bolna API key (starts with bn-). Server-side only — never exposed to the browser.
BOLNA_API_KEY=bn-xxxxxxxxxxxxxxxx
# The Disha coach agent id (create one with `npm run setup:agent`)
BOLNA_AGENT_ID=acc0ced2-24b6-49f9-ac37-db3b0e0f43fc

# --- Optional ---
PORT=8787
BOLNA_API_BASE=https://api.bolna.ai
# Comma-separated list of allowed web origins for CORS (for a separately hosted frontend / mobile dev)
CORS_ORIGINS=http://localhost:5173
# Shared secret appended to the webhook URL (?token=...) so only Bolna can post call results
WEBHOOK_TOKEN=change-me
# Optional: generate richer structured insights (insights, action items, mood) after each call.
# Priority: Gemini > Anthropic > OpenAI. If none is set, Disha falls back to Bolna's built-in call summary.
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override the model, e.g. gemini-2.5-flash / gemini-2.5-pro (default per provider)
INSIGHTS_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
